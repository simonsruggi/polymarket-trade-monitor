# Polymarket Monitor Configuration
# Copy this file to .env and customize the values

# Discord webhook URL for notifications (optional)
# Get this from Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK=

# Minimum trade amount to monitor (USD)
MIN_TRADE_AMOUNT=1000

# Anomaly detection criteria
# Trades with price <= ANOMALY_PRICE_MAX AND size >= ANOMALY_SIZE_MIN are flagged
ANOMALY_PRICE_MAX=0.4
ANOMALY_SIZE_MIN=10000
ANOMALY_AMOUNT_MIN=500

# Maximum age of trades to consider (minutes)
MAX_TRADE_AGE_MINUTES=30

# Keyword filtering (comma-separated, leave empty for no filtering)
# Only trades matching these keywords in the market title will be shown
# Examples:
#   KEYWORDS=bitcoin,ethereum,crypto
#   KEYWORDS=trump,election,politics
#   KEYWORDS=nba,basketball,lakers
KEYWORDS=

# Keyword match mode: "any" or "all"
# - "any": Show trades matching ANY of the keywords (default)
# - "all": Show only trades matching ALL keywords
KEYWORD_MATCH_MODE=any

# Check interval (seconds) - how often to fetch new trades
# Lower = more responsive, but more API calls
# Recommended: 1-5 seconds
LOOP_INTERVAL=1
